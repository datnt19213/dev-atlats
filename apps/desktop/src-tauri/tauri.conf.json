{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevAtlas",
  "version": "0.1.0",
  "identifier": "com.devatlas.desktop",
  "build": {
    "beforeDevCommand": "yarn web:dev",
    "beforeBuildCommand": "yarn build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevAtlas",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
  "shell": {
    "open": true
  }
}
}
